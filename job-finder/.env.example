# ==== Job Finder secrets ====
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# REQUIRED — your Apify API token (Apify Console → Settings → Integrations → API token)
APIFY_TOKEN=

# OPTIONAL — Anthropic API key.
#   If set, scoring uses the Anthropic API directly.
#   If left blank, scoring shells out to `claude -p` (headless Claude Code) so it
#   runs on your existing Claude subscription instead of paid API tokens.
ANTHROPIC_API_KEY=
