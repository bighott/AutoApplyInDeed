{
  "manifest_version": 3,
  "name": "ApplyPilot — Indeed Auto-Apply",
  "version": "0.1.0",
  "description": "Find, rank, and auto-apply to Indeed 'Easily apply' jobs, with a full tracking dashboard. Uses your own Anthropic API key.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "*://*.indeed.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/popup/index.html",
    "default_title": "ApplyPilot"
  },
  "content_scripts": [
    {
      "matches": ["*://*.indeed.com/*"],
      "js": [
        "src/content/indeed-search.ts",
        "src/content/indeed-apply.ts"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/ui/dashboard/index.html"],
      "matches": ["*://*.indeed.com/*"]
    }
  ]
}
