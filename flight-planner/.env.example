# Copy this file to ".env" and fill in the sources you want. ".env" is gitignored.
# Demo prices and the Expedia snapshot need NO credentials.

# Google Flights via SerpApi — https://serpapi.com/manage-api-key  (billed per search)
SERPAPI_KEY=your_serpapi_key_here

# Travelpayouts / Aviasales — https://www.travelpayouts.com/  (free token, real cached prices)
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here

# Amadeus Self-Service — https://developers.amadeus.com/  (free tier; test host by default)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
# Optional: use production host instead of the test sandbox
# AMADEUS_HOSTNAME=https://api.amadeus.com

# --- Stays (Hotels tab) -----------------------------------------------------
# Google Hotels reuses SERPAPI_KEY above (engine=google_hotels) — no extra key.
# Airbnb/VRBO has NO official public API; this targets an unofficial RapidAPI
# scraper. Optional — leave blank to use Demo / Google Hotels only.
# AIRBNB_RAPIDAPI_KEY=your_rapidapi_key_here
# AIRBNB_RAPIDAPI_HOST=airbnb13.p.rapidapi.com
# Optional: override the search URL template for your chosen actor.
# AIRBNB_RAPIDAPI_URL=https://{host}/search-location?location={q}&checkin={in}&checkout={out}&adults={adults}&currency={cur}
